# Jira Cloud
JIRA_BASE_URL=https://montebravo.atlassian.net
JIRA_EMAIL=service-account@montebravo.com.br
JIRA_API_TOKEN=your_api_token_here

# App
PORT=3000
NODE_ENV=development

# Cache TTLs (segundos)
CACHE_TTL_CHANGELOG=3600
CACHE_TTL_SPRINTS=21600
CACHE_TTL_R2=21600
CACHE_TTL_ISSUES=1800
CACHE_TTL_BOARDS=86400

# PDF Export
PUPPETEER_EXECUTABLE_PATH=

# --- Database ---
DATABASE_PROVIDER=postgresql          # "postgresql" | "sqlite"
DATABASE_URL=postgresql://metrics:secret@localhost:5432/metrics_db
DB_MAX_CONNECTIONS=10

# --- Sync Service ---
SYNC_INTERVAL_MINUTES=15             # 15-30 min between sync cycles
FORCE_FULL_RESYNC=false              # true = force full resync on startup
SYNC_MAX_CONCURRENT=5                # Max concurrent Jira API requests during sync

# --- Feature Flag ---
USE_DATABASE_METRICS=false           # true = DB-backed metrics, false = Jira-direct

# --- Cache (DB-backed path) ---
CACHE_TTL_METRICS=300                # seconds (default 5 min, min 60, max 3600)
